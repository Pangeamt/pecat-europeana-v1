## for PROD
NEXTAUTH_SECRET=AX6yHYO63q0sDElcoPPZWYgvI5qdAjJ5
DATABASE_URL=
NEXT_PUBLIC_API_BASE_URL=https://ai4cpecat.pangeanic.com
NEXTAUTH_URL=https://ai4cpecat.pangeanic.com
# Okapi Tikal (document -> XLIFF -> document). Requires Java. On macOS e.g.
# /Applications/okapi/tikal.sh; in the Docker image it is preinstalled as "tikal".
TIKAL_BIN=tikal
# LibreOffice headless, only needed for PDF uploads (PDF -> docx conversion)
SOFFICE_BIN=soffice
# Working folders (one per document: original + XLIFF). Defaults to ./storage
STORAGE_DIR=
# Uploaded originals, outside public/ (never served by URL). Defaults to ./uploads
UPLOADS_DIR=
# Redis backing the BullMQ import queue (see lib/queue.js)
REDIS_URL=redis://127.0.0.1:6379
# QE v2: BASE of the mtqe-v2-api service (http://<host>:8800/mtqe/v2), not an endpoint.
# + X-API-Key. Unset = no QE scores.
MTQE_V2=
MTQE_V2_API_KEY=
# Optional: which of its contracts PECAT-E scores through (default score-segments).
#   score-segments              synchronous; the document's memories and glossaries as ids
#   score-with-references       synchronous; each segment carries its own references as text
#                               (service-mtqe 2.0, e.g. http://<host>:7000/service/mtqe/v2)
#   jobs/score-with-references  the same body as an async job (create, poll, download)
# The profile's instructions travel with all three.
MTQE_V2_ENDPOINT=score-segments
DAAIT_API_HOST=https://api-priv.pangeanic.com/service/autope2
# Optional: longest "instructions" text of a profile, in characters (default 5000,
# never above 65535: the column is a MySQL TEXT). Read when the server starts:
# changing it takes a restart of the container, not a build.
PROFILE_INSTRUCTIONS_MAX=5000
# NexRelay (SDLXLIFF translation via /NexRelay/v1/translate-pecat-e). Use http on :8080.
NEXRELAY_API_HOST=http://prodeuropeana.pangeamt.com:8080
NEXRELAY_API_KEY=pcat-7d9a3f8e2b4c1d6f-default
# Optional: timeout in ms for the NexRelay translate call (default 120000)
NEXRELAY_TIMEOUT=120000