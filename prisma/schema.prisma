generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "accounts_userId_fkey")
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_userId_fkey")
  @@map("sessions")
}

model User {
  id                    String     @id @default(cuid())
  name                  String
  email                 String     @unique
  salt                  String?
  hash                  String?
  emailVerified         DateTime?
  image                 Bytes?
  role                  Role       @default(USER)
  language              String     @default("en")
  provider              String?
  workspaceId           String?
  deletedAt             DateTime?
  accounts              Account[]
  documents             Document[]
  projects              Project[]  @relation("ProjectCreatedBy")
  sessions              Session[]
  workspace             Workspace? @relation("WorkspaceMembers", fields: [workspaceId], references: [id])
  createdTms            Tm[]       @relation("TmCreatedBy")
  createdGlossaries     Glossary[] @relation("GlossaryCreatedBy")
  createdProfiles       Profile[]  @relation("ProfileCreatedBy")
  documentsAsTranslator Document[] @relation("DocumentTranslator")
  documentsAsReviewer   Document[] @relation("DocumentReviewer")

  @@index([workspaceId], map: "users_workspaceId_fkey")
  @@index([deletedAt], map: "users_deletedAt_idx")
  @@map("users")
}

model Workspace {
  id         String     @id @default(cuid())
  name       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  members    User[]     @relation("WorkspaceMembers")
  documents  Document[]
  projects   Project[]
  tms        Tm[]
  glossaries Glossary[]
  profiles   Profile[]

  @@map("workspaces")
}

/// Grouping entity: a workspace project that holds documents and defines the
/// translation defaults (profile, threshold) they inherit.
model Project {
  id              String     @id @default(cuid())
  name            String
  description     String?    @db.Text
  /// Nullable in DB only for backfilled legacy "General" projects; the create
  /// API requires it.
  profileId       String?
  tmThreshold     Float      @default(0.75)
  /// Free-form bag for future per-project options (no migration needed).
  settings        Json?
  createdByUserId String
  workspaceId     String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?
  profile         Profile?   @relation(fields: [profileId], references: [id])
  createdBy       User       @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id])
  workspace       Workspace  @relation(fields: [workspaceId], references: [id])
  documents       Document[]

  @@index([workspaceId], map: "client_projects_workspaceId_fkey")
  @@index([profileId], map: "client_projects_profileId_fkey")
  @@index([createdByUserId], map: "client_projects_createdByUserId_fkey")
  @@index([deletedAt], map: "client_projects_deletedAt_idx")
  @@map("client_projects")
}

/// One uploaded document. Legacy table name "projects" is kept because the
/// database is shared with the running production deployment.
model Document {
  id                 String             @id @default(cuid())
  label              String?
  filename           String
  filePath           String
  uuid               String?            @unique
  accessDeadline     DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  userId             String
  workspaceId        String
  deletedAt          DateTime?
  mt                 Boolean            @default(false)
  tmMode             String             @default("standard")
  tmThreshold        Float              @default(0)
  extension          String             @default("json")
  /// pdocs document id (module-pdocs service); set for documents whose file was
  /// extracted there and needed to rebuild the translated document on export.
  documentId         String?
  sourceLanguage     String?
  targetLanguage     String?
  exampleXml         String?
  /// Lifecycle state as plain string so adding states needs no migration;
  /// the source of truth is lib/document-status.js.
  status             String             @default("UPLOADED")
  /// Parent project; nullable only for legacy rows until the deploy backfill.
  projectId          String?            @map("clientProjectId")
  /// true = TMs/glossaries were materialized from the project profile at
  /// creation; false = they were hand-picked in the upload wizard.
  inheritProfile     Boolean            @default(true)
  /// Assigned reviewer/translator (each workspace user, not necessarily the
  /// uploader): drive both the "who works this document" UI and — for the
  /// USER role — document visibility itself. See buildDocumentScopeWhere.
  translatorId       String?
  reviewerId         String?
  User               User               @relation(fields: [userId], references: [id])
  workspace          Workspace          @relation(fields: [workspaceId], references: [id])
  project            Project?           @relation(fields: [projectId], references: [id])
  translator         User?              @relation("DocumentTranslator", fields: [translatorId], references: [id])
  reviewer           User?              @relation("DocumentReviewer", fields: [reviewerId], references: [id])
  tus                Tu[]
  documentTms        DocumentTm[]
  documentGlossaries DocumentGlossary[]

  @@index([userId], map: "projects_userId_fkey")
  @@index([workspaceId], map: "projects_workspaceId_fkey")
  @@index([projectId], map: "projects_clientProjectId_idx")
  @@index([translatorId], map: "projects_translatorId_fkey")
  @@index([reviewerId], map: "projects_reviewerId_fkey")
  @@map("projects")
}

model Tu {
  id                      String    @id @default(cuid())
  externalId              String?
  translationLiteralId    Int?
  translationId           Int?
  count                   Int?
  fieldName               String?
  shortFieldname          String?
  srcLiteral              String    @db.Text
  translatedLiteral       String?   @db.Text
  reviewLiteral           String?   @db.Text
  sourceLanguage          String
  targetLanguage          String
  translationScorePercent Float?
  tmInfo                  Json?
  glossaryInfo            Json?
  createdAt               DateTime  @default(now())
  exampleXml              String?   @db.VarChar(500)
  updatedAt               DateTime  @updatedAt
  Status                  Status    @default(NOT_REVIEWED)
  documentId              String?   @map("projectId")
  levenshteinDistance     Float?
  block                   Boolean   @default(false)
  belongTo                String?
  /// false = hidden from the review UI and excluded from stats/MT, but kept
  /// so the document export still reconstructs every segment.
  visible                 Boolean   @default(true)
  /// id of the visibility rule that hid this segment (modules/projects/visibility-rules.js)
  hiddenBy                String?
  document                Document? @relation(fields: [documentId], references: [id])

  @@index([documentId], map: "tus_projectId_fkey")
  @@map("tus")
}

model Tm {
  id              String       @id @default(cuid())
  name            String
  domain          String?
  sourceLanguage  String
  targetLanguage  String
  createdByUserId String
  workspaceId     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  createdBy       User         @relation("TmCreatedBy", fields: [createdByUserId], references: [id])
  workspace       Workspace    @relation(fields: [workspaceId], references: [id])
  documentTms     DocumentTm[]
  profileTms      ProfileTm[]

  @@index([workspaceId], map: "tms_workspaceId_fkey")
  @@index([createdByUserId], map: "tms_createdByUserId_fkey")
  @@index([deletedAt], map: "tms_deletedAt_idx")
  @@map("tms")
}

model Glossary {
  id                 String             @id @default(cuid())
  name               String
  domain             String?
  sourceLanguage     String
  targetLanguage     String
  createdByUserId    String
  workspaceId        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  createdBy          User               @relation("GlossaryCreatedBy", fields: [createdByUserId], references: [id])
  workspace          Workspace          @relation(fields: [workspaceId], references: [id])
  documentGlossaries DocumentGlossary[]
  profileGlossaries  ProfileGlossary[]

  @@index([workspaceId], map: "glossaries_workspaceId_fkey")
  @@index([createdByUserId], map: "glossaries_createdByUserId_fkey")
  @@index([deletedAt], map: "glossaries_deletedAt_idx")
  @@map("glossaries")
}

model DocumentTm {
  documentId String   @map("projectId")
  tmId       String
  updateTm   Boolean  @default(false)
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tm       Tm       @relation(fields: [tmId], references: [id], onDelete: Cascade)

  @@id([documentId, tmId])
  @@index([tmId], map: "project_tms_tmId_idx")
  @@map("project_tms")
}

model DocumentGlossary {
  documentId String   @map("projectId")
  glossaryId String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  glossary Glossary @relation(fields: [glossaryId], references: [id], onDelete: Cascade)

  @@id([documentId, glossaryId])
  @@index([glossaryId], map: "project_glossaries_glossaryId_idx")
  @@map("project_glossaries")
}

/// Reusable translation configuration preset: formality, domain and free-text
/// instructions plus the TMs and glossaries to apply when translating.
model Profile {
  id                String            @id @default(cuid())
  name              String
  description       String?           @db.Text
  formality         Formality         @default(FORMAL)
  instructions      String?           @db.Text
  domain            String?
  createdByUserId   String
  workspaceId       String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  createdBy         User              @relation("ProfileCreatedBy", fields: [createdByUserId], references: [id])
  workspace         Workspace         @relation(fields: [workspaceId], references: [id])
  profileTms        ProfileTm[]
  profileGlossaries ProfileGlossary[]
  projects          Project[]

  @@index([workspaceId], map: "profiles_workspaceId_fkey")
  @@index([createdByUserId], map: "profiles_createdByUserId_fkey")
  @@index([deletedAt], map: "profiles_deletedAt_idx")
  @@map("profiles")
}

model ProfileTm {
  profileId String
  tmId      String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tm      Tm      @relation(fields: [tmId], references: [id], onDelete: Cascade)

  @@id([profileId, tmId])
  @@index([tmId], map: "profile_tms_tmId_idx")
  @@map("profile_tms")
}

model ProfileGlossary {
  profileId  String
  glossaryId String
  createdAt  DateTime @default(now())

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  glossary Glossary @relation(fields: [glossaryId], references: [id], onDelete: Cascade)

  @@id([profileId, glossaryId])
  @@index([glossaryId], map: "profile_glossaries_glossaryId_idx")
  @@map("profile_glossaries")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum Role {
  SUPER
  ADMIN
  USER
}

enum Status {
  EDITED
  ACCEPTED
  TRANSLATED_MT
  NOT_REVIEWED
  REJECTED
}

enum Formality {
  FORMAL
  NEUTRO
  INFORMAL
}
